# Server Configuration
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Database (Cloud SQL / Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=xavier_dev

# Cloud SQL (for Cloud Run deployment)
CLOUD_SQL_CONNECTION_NAME=

# Redis (Memorystore / Local Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-64-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-minimum-64-chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Google Cloud Platform (for Cloud Run)
GCP_PROJECT=
GCP_REGION=us-central1

# Email Service (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@xavi.app

# Feature Flags
ENABLE_EMAIL_QUEUE=false
ENABLE_REDIS_CACHE=true

# E-mail configs
EMAIL_API_KEY=your-api-key
EMAIL_FROM=noreply@xavi.app
EMAIL_OTP_EXPIRATION_MINUTES=15
EMAIL_OTP_EXPIRATION_MINUTES=15