# Test Environment Variables
NODE_ENV=test
LOG_LEVEL=silent

# Test Database (use a separate test database)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=xavi_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xavi_test

# Test Redis
ENABLE_REDIS_CACHE=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Test JWT
JWT_ACCESS_SECRET=test-jwt-secret-key-for-testing-only
JWT_REFRESH_SECRET=test-jwt-refresh-secret-for-testing-only
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Test OTP
OTP_SECRET=test-otp-secret
OTP_EXPIRY_MINUTES=5
